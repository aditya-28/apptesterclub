# Copy to .env.local and fill in. Never commit the real file.

# Storage. Vercel Blob is the only backend today; adapters for S3-compatible
# storage and the local filesystem are the next thing being built.
BLOB_READ_WRITE_TOKEN=

# Password for the browsable pages. The session cookie is signed with it, so
# changing this signs everyone out.
ATC_PASSWORD=

# Bearer token the upload API checks. Generate with:
#   openssl rand -hex 24
ATC_UPLOAD_TOKEN=

# Push notifications. Optional — leave blank and the feature stays inert.
# APNS_TOPIC is the bundle identifier of the iOS client you publish.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
