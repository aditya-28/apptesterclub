# Copy to .env.local and fill in. Never commit the real file.

# Storage. Pick one.
#
# Vercel Blob is the default and needs nothing but this token.
BLOB_READ_WRITE_TOKEN=

# Or anything S3-compatible: Cloudflare R2, MinIO, Backblaze B2, AWS S3.
# Setting S3_BUCKET and S3_ACCESS_KEY_ID switches the backend over; leave them
# blank and Blob is used. Binaries are the traffic in this product, and R2
# charges nothing for egress where Blob bills it.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# A folder inside the bucket that this instance owns. Only needed when two
# deployments share one bucket, which is the case when your R2 token is scoped
# to a single bucket. Leave blank otherwise.
S3_PREFIX=

# Only if the bucket is public and you would rather serve straight from it.
# Left blank, each download link is signed at request time and expires in an
# hour, so a copied install link stops working.
S3_PUBLIC_URL=

# Password for the browsable pages. The session cookie is signed with it, so
# changing this signs everyone out.
ATC_PASSWORD=

# Bearer token the upload API checks. Generate with:
#   openssl rand -hex 24
ATC_UPLOAD_TOKEN=

# Push notifications. Optional — leave blank and the feature stays inert.
# APNS_TOPIC is the bundle identifier of the iOS client you publish.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
